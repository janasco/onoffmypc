<?xml version="1.0" encoding="utf-8"?>
<!-- The app talks only to the HTTPS API. No cleartext fallback and no custom
     trust anchors: platform/system CAs only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
