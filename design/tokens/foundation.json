          "critical": {
            "foreground": { "$type": "color", "$value": "{color.primitive.red.300}" },
            "container": { "$type": "color", "$value": "{color.primitive.red.950}" }
          },
          "info": {
            "foreground": { "$type": "color", "$value": "{color.primitive.blue.300}" },
            "container": { "$type": "color", "$value": "{color.primitive.blue.950}" }
          },
          "neutral": {
            "foreground": { "$type": "color", "$value": "#B0BCB2" },
            "container": { "$type": "color", "$value": "{color.primitive.neutral.850}" }
