            "background": { "$type": "color", "$value": "{color.primitive.amber.500}" },
            "foreground": { "$type": "color", "$value": "{color.primitive.black}" }
          }
        },
        "focus": {
          "ring": { "$type": "color", "$value": "{color.primitive.blue.400}" }
