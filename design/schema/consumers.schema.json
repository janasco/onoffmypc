{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onoffmypc.com/schemas/design-consumers.schema.json",
  "title": "OnOffMyPC generated design consumers",
  "type": "object",
  "additionalProperties": false,
  "required": ["designVersion", "artifacts"],
  "properties": {
    "$schema": { "type": "string" },
    "designVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^dist/(?!\\.\\.?(?:/|$))[^/\\\\]+(?:/(?!\\.\\.?(?:/|$))[^/\\\\]+)*$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^(?!\\.\\.?(?:/|$))(?!\\.git(?:/|$))[^/\\\\]+(?:/(?!\\.\\.?(?:/|$))(?!\\.git(?:/|$))[^/\\\\]+)+$"
        }
      }
    }
  }
}
