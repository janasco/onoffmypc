# OnOffMyPC Android — secrets template
# ─────────────────────────────────────
# 1. Copy:  cp .env.example .env
# 2. Fill in values (never commit .env)
#
# For release signing, copy these into keystore.properties:
#   cp .env.example keystore.properties   (then edit keystore.properties)

# Release keystore (local signed builds — CI uses GitHub Secrets instead)
KEYSTORE_FILE=/absolute/path/to/onoffmypc-release.jks
KEYSTORE_PASSWORD=
KEY_ALIAS=onoffmypc
KEY_PASSWORD=

# Optional: GitHub PAT for private dependency fetch (prefer SSH remotes)
# GITHUB_TOKEN=

# Note: google-services.json lives at app/google-services.json (Firebase client config, not a secret)
