# ESP32 Firmware — secrets & tokens inventory
# ─────────────────────────────────────────────
# 1. Copy:  cp .env.example .env
# 2. Fill real values in .env  (NEVER commit .env — it is gitignored)
#
# NOTE: GitHub Actions does NOT read this file. CI secrets must be added at:
#   GitHub → esp32-firmware → Settings → Secrets and variables → Actions

# ── Local dev / Wokwi compile-time config ────────────────────────────────────
# Production devices provision over the captive portal (WPA2 AP + setup PIN),
# not this file. For local compile, copy into a gitignored src/config.h:
#   cp src/config.example.h src/config.h
WIFI_SSID=YourWiFiSSID
WIFI_PASSWORD=YourWiFiPassword
DEVICE_ID=your-device-uuid
DEVICE_TOKEN=your-device-token
PC_MAC=AA:BB:CC:DD:EE:FF
# API host (TLS pinned in firmware — do not change unless you control the server)
API_HOST=api.onoffmypc.com

# ── CI — GitHub Actions repo secrets (firmware build + release) ──────────────
# Used by the release workflow that publishes signed .bin files and updates
# download links. Set these in repo Settings, not in this file.
RELEASE_REPO_TOKEN=                # fine-grained PAT, Contents: write on onoffmypc/onoffmypc-release
WEB_REPO_TOKEN=                    # fine-grained PAT, Contents: write on onoffmypc/onoffmypc-web (update firmware download refs)
CLOUDFLARE_API_TOKEN=              # if the firmware CI touches Cloudflare (e.g. OTA hosting)
CLOUDFLARE_ACCOUNT_ID=
