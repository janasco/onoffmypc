# ESP32 Firmware — local dev template
# ───────────────────────────────────
# 1. Copy:  cp .env.example .env
# 2. Fill in values (never commit .env)
#
# Production devices use the captive portal (WPA2 AP + setup PIN) — not this file.
# For Wokwi / local compile-time config, copy values into src/config.h:
#   cp src/config.example.h src/config.h

WIFI_SSID=YourWiFiSSID
WIFI_PASSWORD=YourWiFiPassword
DEVICE_ID=your-device-uuid
DEVICE_TOKEN=your-device-token
PC_MAC=AA:BB:CC:DD:EE:FF

# API (TLS pinned in firmware — do not change unless you control the server)
API_HOST=api.onoffmypc.com
