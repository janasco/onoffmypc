      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-dht22",
      "id": "dht",
      "top": -80,
      "left": 220,
      "attrs": { "temperature": "22.5", "humidity": "55" }
    },
    {
      "type": "wokwi-led",
      "id": "led-status",
      "top": -80,
      "left": 340,
      "attrs": { "color": "blue", "label": "Status" }
    },
    {
      "type": "wokwi-led",
      "id": "led-pc",
      "top": -80,
      "left": 400,
      "attrs": { "color": "green", "label": "PC Power" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 20,
      "left": 340,
      "attrs": { "value": "330" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r2",
      "top": 20,
      "left": 400,
      "attrs": { "value": "330" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn-power",
      "top": 80,
      "left": 220,
      "attrs": { "color": "red", "label": "PC Power Btn" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn-reset",
      "top": 80,
      "left": 310,
      "attrs": { "color": "orange", "label": "PC Reset Btn" }
    }
