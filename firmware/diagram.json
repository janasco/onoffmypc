  "connections": [
    ["esp:GND.1",    "dht:GND",        "black",  []],
    ["esp:3V3",      "dht:VCC",        "red",    []],
    ["esp:D4",       "dht:SDA",        "green",  []],

    ["esp:D2",       "r1:1",           "yellow", []],
    ["r1:2",         "led-status:A",   "yellow", []],
    ["led-status:C", "esp:GND.2",      "black",  []],

    ["esp:D34",      "led-pc:A",       "green",  []],
    ["led-pc:C",     "r2:1",           "green",  []],
    ["r2:2",         "esp:GND.2",      "black",  []],

    ["esp:D26",      "btn-power:1.l",  "red",    []],
    ["btn-power:2.l","esp:GND.2",      "black",  []],

    ["esp:D27",      "btn-reset:1.l",  "orange", []],
    ["btn-reset:2.l","esp:GND.2",      "black",  []]
  ]
}
