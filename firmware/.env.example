# ESP32 Firmware — secrets & tokens inventory
# ─────────────────────────────────────────────
# 1. Copy:  cp .env.example .env
# 2. Fill real values in .env  (NEVER commit .env — it is gitignored)
#
# ── Payments are server-only ────────────────────────────────────────────────
# Do not add Polar access tokens, webhook secrets, or product IDs to firmware.
# The device never talks to Polar; payment configuration belongs only in
# onoffmypc-app/.env and access is delivered through API-side entitlements.

# ── Local dev / Wokwi compile-time config ────────────────────────────────────
# Production devices provision over the captive portal (WPA2 AP + setup PIN),
# not this file. For local compile, copy into a gitignored src/config.h:
#   cp src/config.example.h src/config.h
# Local test Wi-Fi network name. Never bake a personal network into release firmware.
WIFI_SSID=YourWiFiSSID
# Local test Wi-Fi password. Production provisioning stores this per device.
WIFI_PASSWORD=YourWiFiPassword
# UUID of a development device already registered to the matching API environment.
DEVICE_ID=your-device-uuid
# Secret token for that development device. Rotate it if this file is exposed.
DEVICE_TOKEN=your-device-token
# Wake-on-LAN MAC address of the local development PC.
PC_MAC=AA:BB:CC:DD:EE:FF
# API host (TLS pinned in firmware — do not change unless you control the server)
API_HOST=api.onoffmypc.com

# ── Release publishing (manual) ─────────────────────────────────────────────
# Build with tools/release.sh, then upload the artifacts to Cloudflare R2 by
# hand (see release/R2-RELEASES.md). These values are only needed for that
# upload; no CI pipeline reads this file.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
