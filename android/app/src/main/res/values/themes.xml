<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. The UI is drawn by Compose (OnOffMyPCTheme);
         this platform theme just provides a dark, no-action-bar shell with
         transparent system bars for edge-to-edge. -->
    <style name="Theme.OnOffMyPC" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#0F0F0F</item>
    </style>
</resources>
